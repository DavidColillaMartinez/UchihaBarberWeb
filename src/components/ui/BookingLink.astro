---
import styles from "./BookingLink.module.css";

interface Props {
  class?: string;
}

/* Única fuente del linkeo al sistema externo de reservas (PRODUCT.md).
   Pendiente: comprobar si Yeasy permite enlaces por servicio; mientras,
   todos los accesos enlazan a la página general de reservas.
   Los enlaces externos se abren en una pestaña nueva sin sacar al usuario
   de la web. */
const bookingUrl =
  "https://yeasy.io/commerce/7b8627f1-9c5e-46a6-ab95-ef6e0e1b87da";

const { class: className } = Astro.props;
---

<a
  class={className}
  href={bookingUrl}
  target="_blank"
  rel="noopener noreferrer"
>
  <slot />
  <span class={styles.oculto}>(se abre en una pestaña nueva)</span>
</a>
