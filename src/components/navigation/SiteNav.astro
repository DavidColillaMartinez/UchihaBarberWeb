---
import styles from "./SiteNav.module.css";
import BookingLink from "@/components/ui/BookingLink.astro";

interface Props {
  isHomePage?: boolean;
  currentPage?: "home" | "products";
}

const { isHomePage = false, currentPage = "home" } = Astro.props;

const anchor = (id: string) => (isHomePage ? `#${id}` : `/#${id}`);
---

<nav
  class={styles.nav}
  aria-label="Navegación principal"
  data-home={isHomePage ? "true" : undefined}
>
  <ul class={styles.list}>
    <li>
      <a href={anchor("servicios")}>Servicios</a>
    </li>
    <li>
      <a
        href="/productos"
        aria-current={currentPage === "products" ? "page" : undefined}
      >
        Productos
      </a>
    </li>
    <li>
      <a href={anchor("opiniones")}>Opiniones</a>
    </li>
    <li>
      <a href={anchor("info")}>Información</a>
    </li>
  </ul>
  <BookingLink class={styles.cita}>Pedir cita</BookingLink>
</nav>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const nav = document.querySelector<HTMLElement>(
    'nav[aria-label="Navegación principal"]',
  );

  if (nav) {
    const esPortada = nav.dataset.home === "true";
    const umbral = 120;

    const enPortadaArriba = (scroll: number) => esPortada && scroll <= umbral;

    /* En la portada, lo alto lo ocupa la barra de inicio; el nav fijo no se
       muestra hasta que el recorrido avanza. Sin JS queda visible por CSS. */
    if (esPortada) {
      gsap.set(nav, { autoAlpha: 0 });
    }

    const media = gsap.matchMedia();

    /* Movimiento reducido: visible como tira sin transiciones animadas,
       salvo en lo alto de la portada, donde manda la barra. */
    media.add("(prefers-reduced-motion: reduce)", () => {
      const aplicar = () => {
        gsap.set(nav, {
          autoAlpha: enPortadaArriba(window.scrollY) ? 0 : 1,
        });
      };
      aplicar();
      window.addEventListener("scroll", aplicar, { passive: true });
      return () => window.removeEventListener("scroll", aplicar);
    });

    media.add("(prefers-reduced-motion: no-preference)", () => {
      ScrollTrigger.create({
        start: 0,
        end: "max",
        onUpdate: (self) => {
          if (enPortadaArriba(self.scroll())) {
            gsap.to(nav, { autoAlpha: 0, duration: 0.25, overwrite: true });
            return;
          }
          if (self.scroll() <= umbral) {
            gsap.to(nav, { autoAlpha: 1, overwrite: true });
            return;
          }
          if (self.direction === 1) {
            gsap.to(nav, { autoAlpha: 0, duration: 0.25, overwrite: true });
          } else if (self.direction === -1) {
            gsap.to(nav, {
              autoAlpha: 1,
              duration: 0.25,
              delay: 0.1,
              overwrite: true,
            });
          }
        },
      });
    });
  }
</script>
