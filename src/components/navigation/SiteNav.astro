---
import styles from "./SiteNav.module.css";

interface Props {
  isHomePage?: boolean;
  currentPage?: "home" | "products";
}

const { isHomePage = false, currentPage = "home" } = Astro.props;

/* URL confirmada del sistema externo de reservas (PRODUCT.md).
   Enlace simple: no se asumen API, embeds ni parámetros de Yeasy. */
const bookingUrl =
  "https://yeasy.io/commerce/7b8627f1-9c5e-46a6-ab95-ef6e0e1b87da";

const anchor = (id: string) => (isHomePage ? `#${id}` : `/#${id}`);
---

<nav class={styles.nav} aria-label="Navegación principal">
  <ul class={styles.list}>
    <li>
      <a
        href={isHomePage ? "#contenido" : "/"}
        aria-current={currentPage === "home" ? "page" : undefined}
      >
        Uchiha Barber
      </a>
    </li>
    <li>
      <a href={anchor("servicios")}>Servicios</a>
    </li>
    <li>
      <a
        href="/productos"
        aria-current={currentPage === "products" ? "page" : undefined}
      >
        Productos
      </a>
    </li>
    <li>
      <a href={anchor("opiniones")}>Opiniones</a>
    </li>
    <li>
      <a href={anchor("info")}>Información</a>
    </li>
    <li>
      <!-- Texto funcional provisional; se ajustará con el responsable. -->
      <a href={bookingUrl}>Pedir cita</a>
    </li>
  </ul>
</nav>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const nav = document.querySelector<HTMLElement>(
    'nav[aria-label="Navegación principal"]',
  );
  if (nav) {
    const UMBRAL_LUMINANCIA = 128;

    /* Luminancia del fondo real bajo el nav, subiendo por los ancestros
       hasta encontrar un color opaco. Evita depender del blend y funciona
       igual sobre vídeo o fondos que cambien de color por sección. */
    const fondoEsClaro = (elemento: Element | null): boolean => {
      let actual: Element | null = elemento;
      while (actual) {
        const fondo = getComputedStyle(actual).backgroundColor;
        const coincidencia = /rgba?\(([^)]+)\)/.exec(fondo);
        if (coincidencia) {
          const [r, g, b, a = "1"] = coincidencia[1]
            .split(",")
            .map((valor) => parseFloat(valor));
          if (parseFloat(a) > 0.5) {
            return 0.2126 * r + 0.7152 * g + 0.0722 * b > UMBRAL_LUMINANCIA;
          }
        }
        actual = actual.parentElement;
      }
      return true;
    };

    const seccionBajoNav = (): Element | null => {
      const contenedor = document.querySelector("main#contenido");
      if (!contenedor) return null;
      for (const hijo of Array.from(contenedor.children)) {
        const caja = hijo.getBoundingClientRect();
        if (caja.top <= 1 && caja.bottom > 1) return hijo;
      }
      return null;
    };

    const actualizarTema = () => {
      nav.dataset.theme = fondoEsClaro(seccionBajoNav()) ? "light" : "dark";
    };

    actualizarTema();
    window.addEventListener("resize", actualizarTema);
    ScrollTrigger.create({
      start: 0,
      end: "max",
      onUpdate: actualizarTema,
      onRefresh: actualizarTema,
    });

    const media = gsap.matchMedia();

    /* Movimiento reducido: el nav permanece siempre visible. */
    media.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set(nav, { autoAlpha: 1 });
      return () => {};
    });

    media.add("(prefers-reduced-motion: no-preference)", () => {
      const umbral = 120;

      ScrollTrigger.create({
        start: 0,
        end: "max",
        onUpdate: (self) => {
          if (self.scroll() <= umbral) {
            gsap.to(nav, { autoAlpha: 1, overwrite: true });
            return;
          }
          if (self.direction === 1) {
            gsap.to(nav, { autoAlpha: 0, duration: 0.25, overwrite: true });
          } else if (self.direction === -1) {
            gsap.to(nav, {
              autoAlpha: 1,
              duration: 0.25,
              delay: 0.1,
              overwrite: true,
            });
          }
        },
      });
    });
  }
</script>
