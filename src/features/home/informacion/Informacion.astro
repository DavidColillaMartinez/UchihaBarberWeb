---
import styles from "./Informacion.module.css";
import ProvisionalNote from "@/components/ui/ProvisionalNote.astro";
import BookingLink from "@/components/ui/BookingLink.astro";

/* Ubicación confirmada en PRODUCT.md; dirección detallada, horarios y contacto pendientes. */
const ubicacion = "Torrejón de Ardoz, Madrid";
---

<section id="info" class={styles.informacion} aria-labelledby="info-titulo">
  <h2 id="info-titulo" class={styles.titulo}>
    Información
  </h2>
  <p class={styles.ubicacion}>{ubicacion}</p>
  <p class={styles.reserva}>
    <BookingLink>Pedir cita</BookingLink>
  </p>
  <!-- Pendiente: dirección detallada, horarios, teléfono y perfiles oficiales
       (Instagram/Google) validados antes de publicarlos. -->
  <ProvisionalNote>
    Información provisional · pendiente de datos validados
  </ProvisionalNote>
</section>
