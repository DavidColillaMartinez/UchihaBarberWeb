---
import styles from "./Servicios.module.css";
import BookingLink from "@/components/ui/BookingLink.astro";

/* Vídeo demo servido desde el repo; se sustituirá por la URL del VPS propio
   con el contenido real (PRODUCT.md). Basta cambiar esta constante. */
const videoUrl = "/videos/Video_Head.mp4";

/* Listado real publicado en Yeasy (nombre, duración y precio; consultado
   2026-09-16). Las descripciones fueron facilitadas por el responsable
   durante los ajustes (SES-009-servicios-ajustes). */
const servicios = [
  {
    nombre: "Corte de pelo",
    precio: "14 €",
    descripcion:
      "Corte clásico o moderno adaptado a tu estilo y tipo de cabello, con la precisión y el cuidado necesarios para que salgas luciendo impecable.",
  },
  {
    nombre: "Corte de pelo + Barba",
    precio: "19 €",
    descripcion:
      "Define tu imagen con un corte de pelo impecable y una barba cuidada, todo en una misma sesión para un acabado armónico y profesional.",
  },
  {
    nombre: "Corte de pelo + Arreglo de barba tradicional",
    precio: "25 €",
    descripcion:
      "La experiencia clásica: corte de pelo y arreglo de barba al estilo tradicional, con toalla caliente y técnicas artesanales para un acabado elegante y preciso.",
  },
  {
    nombre: "Arreglo de barba",
    precio: "8 €",
    descripcion:
      "Rápido y eficaz: retoca y da forma a tu barba para mantenerla limpia y bien definida en pocos minutos.",
  },
  {
    nombre: "Corte con lavado de cabeza",
    precio: "16 €",
    descripcion:
      "Renueva tu look con un corte de pelo adaptado a tu estilo, acompañado de un lavado relajante que deja tu cabello limpio, suave y listo para lucir perfecto.",
  },
  {
    nombre: "Corte de pelo para jubilados",
    precio: "10 €",
    descripcion:
      "Un corte clásico o moderno adaptado a tu gusto, con la atención y el cuidado que mereces, a un precio especial para jubilados.",
  },
  {
    nombre: "Corte de pelo para niños",
    precio: "12 €",
    descripcion:
      "Cortes divertidos y cuidados para los más pequeños, con paciencia y atención para que se sientan cómodos y salgan sonriendo.",
  },
  {
    nombre: "Servicio VIP",
    precio: "35 €",
    descripcion:
      "El cuidado definitivo para el hombre actual. Incluye asesoría personalizada, corte de precisión, ritual tradicional de barba (toalla caliente, navaja, aceites y aftershave), exfoliación de pelo, champú específico y peinado con productos de alta gama.",
  },
];
---

<section
  id="servicios"
  class={styles.servicios}
  data-servicios
  aria-labelledby="servicios-titulo"
>
  <div class={styles.escena} data-escena-servicios>
    <div class={styles.tituloMarco}>
      <div class={styles.tituloGrupo} data-titulo-servicios>
        <h2 id="servicios-titulo" class={styles.titulo} data-palabra-servicios>
          Servicios
        </h2>
        <!-- El vídeo se funde sobre el texto: solo se ve dentro de las letras
             (modo de fusión screen sobre el blanco y el negro de la palabra). -->
        <video
          class={styles.videoLetras}
          data-video-servicios
          src={videoUrl}
          autoplay
          muted
          loop
          playsinline
          aria-hidden="true"
          tabindex="-1"
        ></video>
      </div>
    </div>

    <ul class={styles.lista} data-lista-servicios>
      {servicios.map((servicio) => (
        <li class={styles.item}>
          <BookingLink class={styles.fila}>
            <span class={styles.textos}>
              <span class={styles.nombre}>{servicio.nombre}</span>
            </span>
            <span class={styles.descripcionContenedor}>
              <span class={styles.descripcion}>{servicio.descripcion}</span>
            </span>
            <span class={styles.precio}>{servicio.precio}</span>
            <span class={styles.llamada}>Reserva ya</span>
          </BookingLink>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const seccion = document.querySelector<HTMLElement>("[data-servicios]");
  const escena = seccion?.querySelector<HTMLElement>("[data-escena-servicios]");
  const grupo = seccion?.querySelector<HTMLElement>("[data-titulo-servicios]");
  const palabra = seccion?.querySelector<HTMLElement>(
    "[data-palabra-servicios]",
  );
  const lista = seccion?.querySelector<HTMLElement>("[data-lista-servicios]");

  const video = document.querySelector<HTMLVideoElement>(
    "video[data-video-servicios]",
  );

  const movimientoReducido = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );

  /* Mide la tinta real de la palabra con un canvas, en las mismas
     condiciones que el h2 (misma familia, tamaño y peso): devuelve el alto
     de la tinta y su distancia al borde superior de la caja, para poder
     llevarla exactamente de borde a borde del listado. */
  const medirTinta = () => {
    if (!palabra || !grupo) {
      return null;
    }
    const cs = getComputedStyle(palabra);
    const lienzo = document.createElement("canvas");
    const ctx = lienzo.getContext("2d");
    if (!ctx) {
      return null;
    }
    ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
    const medida = ctx.measureText(palabra.textContent?.trim() || "Servicios");
    const asc = medida.actualBoundingBoxAscent;
    const desc = medida.actualBoundingBoxDescent;
    if (!Number.isFinite(asc) || !Number.isFinite(desc)) {
      return null;
    }
    const fuenteAsc = medida.fontBoundingBoxAscent;
    const fuenteDesc = medida.fontBoundingBoxDescent;
    const lineH = parseFloat(cs.lineHeight) || parseFloat(cs.fontSize);
    const lineaBase = (lineH - (fuenteAsc + fuenteDesc)) / 2 + fuenteAsc;
    return {
      anchoCaja: Math.max(grupo.offsetWidth, 1),
      altoTinta: Math.max(asc + desc, 1),
      /* Distancia de la tinta al borde del grupo (origen del transform),
         contando el margen interior que separa el vídeo del fondo. */
      tintaArriba: palabra.offsetTop + lineaBase - asc,
    };
  };

  /* Calcula la escala y el desplazamiento de los dos estados, con las
     proporciones naturales de la palabra (escala uniforme, sin estirar):
     reposo (banner a sangre, centrado) y pausa (columna izquierda,
     centrado respecto al listado). La fuente de titular se puede cambiar
     en el CSS; las medidas se recalculan con las métricas reales. */
  const calcular = () => {
    if (!escena || !grupo || !lista) {
      return null;
    }
    const medidas = medirTinta();
    if (!medidas) {
      return null;
    }
    const altoLista = lista.offsetHeight;
    const anchoColumna =
      grupo.parentElement?.clientWidth ?? escena.offsetWidth / 2;
    const anchoEscena = escena.offsetWidth;

    const escalaPausa = anchoColumna / medidas.anchoCaja;
    const desplazaYPausa =
      (altoLista - medidas.altoTinta * escalaPausa) / 2 -
      medidas.tintaArriba * escalaPausa;

    const escalaReposo = anchoEscena / medidas.anchoCaja;
    const desplazaYReposo =
      (altoLista - medidas.altoTinta * escalaReposo) / 2 -
      medidas.tintaArriba * escalaReposo;

    return {
      escalaPausa,
      desplazaYPausa,
      escalaReposo,
      desplazaYReposo,
    };
  };

  /* Estado pausado en CSS (fallback sin gsap o con movimiento reducido).
     En móvil la palabra vuelve al flujo normal. */
  const fijarTitulo = () => {
    if (!grupo) {
      return;
    }
    if (!window.matchMedia("(min-width: 48rem)").matches) {
      grupo.style.removeProperty("--escala");
      grupo.style.removeProperty("--desplaza-y");
      return;
    }
    const valores = calcular();
    if (!valores) {
      return;
    }
    grupo.style.setProperty("--escala", `${valores.escalaPausa}`);
    grupo.style.setProperty("--desplaza-y", `${valores.desplazaYPausa}px`);
  };

  fijarTitulo();
  window.addEventListener("resize", fijarTitulo);
  if (document.fonts) {
    void document.fonts.ready.then(fijarTitulo);
  }

  if (video && movimientoReducido.matches) {
    video.removeAttribute("autoplay");
    video.pause();
  }

  /* Pausa el vídeo de las letras cuando la sección no está en pantalla. */
  if (seccion && video) {
    new IntersectionObserver(
      (entradas) => {
        const entrada = entradas[0];
        if (!entrada) {
          return;
        }
        if (entrada.isIntersecting && !movimientoReducido.matches) {
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      },
      { threshold: 0 },
    ).observe(seccion);
  }

  /* Transformación al scroll: el banner se mantiene completo y quieto hasta
     que su borde superior llega al 50 % del viewport; ahí la palabra pasa a
     la columna izquierda conservando sus proporciones, mientras la lista
     entra desde abajo en la mitad derecha. Sin JS ni con movimiento reducido
     se queda el estado final compuesto. */
  if (seccion && escena && grupo && lista) {
    gsap
      .matchMedia()
      .add(
        "(min-width: 48rem) and (prefers-reduced-motion: no-preference)",
        () => {
          const linea = gsap.timeline({
            scrollTrigger: {
              trigger: seccion,
              start: "top 50%",
              end: "top 0%",
              scrub: 0.8,
              invalidateOnRefresh: true,
            },
          });

          linea
            .fromTo(
              grupo,
              {
                transformOrigin: "left top",
                y: () => calcular()?.desplazaYReposo ?? 0,
                scale: () => calcular()?.escalaReposo ?? 1,
              },
              {
                y: () => calcular()?.desplazaYPausa ?? 0,
                scale: () => calcular()?.escalaPausa ?? 1,
                ease: "expo.inOut",
              },
              0,
            )
            .fromTo(
              lista,
              { opacity: 0, yPercent: 40 },
              { opacity: 1, yPercent: 0, ease: "expo.out" },
              0.25,
            );
        },
      );
  }
</script>
