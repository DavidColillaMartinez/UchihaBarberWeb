---
import styles from "./Cabecera.module.css";
import BarraInicio from "@/components/navigation/BarraInicio.astro";

/* Vídeo de fondo: material demo servido desde el repo. Se sustituirá por
   la URL del VPS propio con el contenido real (PRODUCT.md); basta cambiar aquí. */
const videoUrl = "/videos/Video_Head.mp4";
---

<section class={styles.cabecera} aria-labelledby="cabecera-titulo">
  <!-- Vídeo de fondo en blanco y negro a pantalla completa (PRODUCT.md). -->
  <video
    class={styles.video}
    data-video-fondo
    src={videoUrl}
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <BarraInicio />

  <!-- El nombre queda solo para lectores de pantalla: la presencia visual
       la lleva el vídeo con la barra de navegación encima. -->
  <h1 id="cabecera-titulo" class={styles.srOnly}>
    Uchiha Barber
  </h1>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>(
    "video[data-video-fondo]",
  );

  if (video && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    video.removeAttribute("autoplay");
    video.pause();
  }
</script>
